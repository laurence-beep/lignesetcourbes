---
import "../styles/global.css";

const navItems = [
	"Particuliers",
	"Professionnels",
	"Services",
	"Projets",
	"Méthode",
	"À propos",
	"Contact",
];

const projects = [
	{ name: "Meudon", type: "Maison familiale", image: "/images/loft-colombes-hero.jpeg" },
	{ name: "Boulogne", type: "Appartement rénové", image: "/images/interieur-sideboard.jpeg" },
	{ name: "Viroflay", type: "Lieu de vie optimisé", image: "/images/loft-detail.jpeg" },
	{ name: "Treeefle", type: "Espace collaboratif", image: "/images/atelier-codesign.jpg" },
	{ name: "AXA Lab", type: "Environnement professionnel", image: "/images/offre-design.jpg" },
];

const methodSteps = [
	["01", "Clarifier", "Objectifs, contraintes, budget et potentiel du lieu."],
	["02", "Concevoir", "Plans, scénarios d'usage, matières, couleurs et mobilier."],
	["03", "Préparer", "Dossier de consultation, devis, arbitrages et planning."],
	["04", "Réaliser", "Coordination, suivi, ajustements et livraison sereine."],
];

---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Architecture d'intérieur pour particuliers et professionnels : concevoir des lieux qui vous ressemblent et qui vous portent."
		/>
		<title>Lignes et courbes - Architecture d'intérieur</title>
	</head>
	<body class="bg-paper text-ink">
		<header class="site-shell sticky top-0 z-50 py-2">
			<div class="surface flex items-center justify-between gap-4 px-5 py-2 shadow-none backdrop-blur-xl">
				<a href="/" aria-label="Lignes et courbes" class="flex items-center gap-3">
					<img src="/brand/lignes-et-courbes-logo.svg" alt="Lignes et courbes" class="h-12 w-auto sm:h-14" />
				</a>
				<nav class="hidden items-center gap-5 text-sm font-semibold text-ink-soft lg:flex" aria-label="Navigation principale">
					{navItems.map((item) => <a href={`#${item.toLowerCase().replaceAll(" ", "-").replace("à", "a").replace("é", "e")}`} class="hover:text-line-blue">{item}</a>)}
				</nav>
				<a href="#contact" class="btn btn-primary hidden xl:inline-flex">Parler de mon projet</a>
			</div>
		</header>

		<main>
			<section id="accueil">
				<section class="relative min-h-[calc(100vh-142px)] overflow-hidden">
					<img src="/images/loft-colombes-hero.jpeg" alt="Intérieur rénové par Lignes et courbes" class="absolute inset-0 h-full w-full object-cover" />
					<div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(31,38,48,.76),rgba(31,38,48,.42),rgba(31,38,48,.1))]"></div>
					<div class="site-shell relative flex min-h-[calc(100vh-142px)] flex-col justify-center py-20 text-white">
						<p class="eyebrow text-line-gold">Architecture d'intérieur - lieux de vie et de travail</p>
						<h2 class="display-serif mt-5 max-w-4xl text-5xl md:text-7xl">Concevoir des lieux qui vous ressemblent - et qui vous apaisent</h2>
						<p class="mt-7 max-w-2xl text-lg leading-8 text-white/86">
							Une version plus douce de la première piste : le même niveau de cadrage, mais une entrée plus contemplative, centrée sur la justesse des usages, des matières et du quotidien.
						</p>
						<div class="mt-9 flex flex-col gap-3 sm:flex-row">
							<a href="#contact" class="btn bg-white text-line-blue hover:bg-line-gold-soft">Parler de mon projet</a>
							<a href="#projets" class="btn border-white/70 text-white hover:bg-white/12">Découvrir les projets</a>
						</div>
					</div>
				</section>

					<section class="site-shell grid gap-10 py-20 lg:grid-cols-[0.8fr_1.2fr]">
						<div>
							<p class="eyebrow">Une écoute, deux horizons</p>
							<h3 class="mt-3 text-4xl font-semibold text-line-blue">Un cadre clair pour décider sans brusquer le projet</h3>
							<p class="mt-5 text-ink-soft">Cette variante met davantage l'accent sur la confiance, la fluidité et la sensation d'accompagnement.</p>
						</div>
						<div class="grid gap-4 md:grid-cols-2">
							<a id="particuliers" href="#particuliers" class="surface p-7 shadow-none">
								<p class="text-sm font-bold text-line-gold">Pour les particuliers</p>
								<h4 class="mt-4 text-2xl font-bold text-line-blue">Rendre un lieu évident à vivre</h4>
								<p class="mt-4 text-ink-soft">Clarifier les priorités, révéler le potentiel et préparer les arbitrages avant les travaux.</p>
							</a>
							<a id="professionnels" href="#professionnels" class="surface p-7 shadow-none">
								<p class="text-sm font-bold text-line-gold">Pour les professionnels</p>
								<h4 class="mt-4 text-2xl font-bold text-line-blue">Créer un espace aligné et accueillant</h4>
								<p class="mt-4 text-ink-soft">Faire parler la marque, les usages et les modes de collaboration sans surcharger l'espace.</p>
							</a>
						</div>
					</section>

					<section id="projets" class="bg-white py-20">
					<div class="site-shell">
						<div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
							<div>
								<p class="eyebrow">Projets phares</p>
								<h3 class="mt-3 max-w-3xl text-4xl font-semibold text-line-blue">Une sélection plus éditoriale, comme un carnet de lieux</h3>
							</div>
							<p class="text-ink-soft">Les projets restent volontairement en aperçu pour garder la homepage lisible avant le travail de contenu détaillé.</p>
						</div>
						<div class="mt-10 grid gap-4 lg:grid-cols-[1.2fr_0.8fr]">
							<article class="project-card">
								<img src="/images/loft-colombes-hero.jpeg" alt="Meudon" class="aspect-[16/10]" />
								<div class="p-6">
									<p class="eyebrow">Projet repère</p>
									<h4 class="mt-2 text-2xl font-bold text-line-blue">Meudon</h4>
									<p class="mt-2 text-ink-soft">Un lieu de vie transformé par les volumes, la lumière et les circulations.</p>
								</div>
							</article>
							<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
								{projects.slice(1).map((project) => (
									<a href="#projets" class="grid grid-cols-[96px_1fr] gap-4 border-t border-line-blue/15 py-4">
										<img src={project.image} alt={project.name} class="h-24 w-24 rounded-site object-cover" />
										<span>
											<span class="block text-lg font-bold text-line-blue">{project.name}</span>
											<span class="mt-1 block text-sm text-ink-soft">{project.type}</span>
										</span>
									</a>
								))}
							</div>
						</div>
					</div>
				</section>

					<section id="methode" class="site-shell py-20">
					<div class="border-y border-line-blue/15 py-10">
						<p class="eyebrow">Méthode</p>
						<div class="mt-7 grid gap-6 md:grid-cols-4">
							{methodSteps.map(([number, title, text]) => (
								<article>
									<p class="text-sm font-bold text-line-gold">{number}</p>
									<h4 class="mt-3 text-xl font-bold text-line-blue">{title}</h4>
									<p class="mt-3 text-sm leading-6 text-ink-soft">{text}</p>
								</article>
							))}
						</div>
					</div>
				</section>
			</section>

				<section id="contact" class="bg-line-blue py-20 text-white">
				<div class="site-shell grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
					<div>
						<p class="eyebrow text-line-gold">Contact</p>
						<h2 class="mt-3 text-4xl font-semibold md:text-5xl">Parlons du lieu que vous voulez transformer</h2>
						<p class="mt-5 max-w-xl text-white/78">
							Le formulaire prépare le cadrage : type de projet, budget, surface, localisation et délai.
						</p>
						<div class="mt-8 text-sm leading-7 text-white/82">
							<p>19, rue des Verrières - 92310 Sèvres</p>
							<p>contact@lignesetcourbes.com</p>
							<p>+33 6 50 14 39 52</p>
						</div>
					</div>
					<form class="grid gap-4 rounded-site border border-white/18 bg-white/10 p-5 backdrop-blur-md">
						<div class="grid gap-4 md:grid-cols-2">
							<label class="grid gap-2 text-sm font-bold">Type de projet<select class="rounded-site border border-white/20 bg-white px-3 py-3 text-ink"><option>Particulier</option><option>Professionnel</option></select></label>
							<label class="grid gap-2 text-sm font-bold">Budget<input class="rounded-site border border-white/20 bg-white px-3 py-3 text-ink" placeholder="Ex. 80 000 €" /></label>
							<label class="grid gap-2 text-sm font-bold">Surface<input class="rounded-site border border-white/20 bg-white px-3 py-3 text-ink" placeholder="Ex. 90 m2" /></label>
							<label class="grid gap-2 text-sm font-bold">Localisation<input class="rounded-site border border-white/20 bg-white px-3 py-3 text-ink" placeholder="Sèvres, Boulogne, Paris..." /></label>
						</div>
						<label class="grid gap-2 text-sm font-bold">Délai<input class="rounded-site border border-white/20 bg-white px-3 py-3 text-ink" placeholder="Ex. emménagement en septembre" /></label>
						<label class="grid gap-2 text-sm font-bold">Message<textarea class="min-h-32 rounded-site border border-white/20 bg-white px-3 py-3 text-ink" placeholder="Quelques mots sur le lieu, vos envies et vos contraintes"></textarea></label>
						<button type="button" class="btn bg-line-gold text-line-blue hover:bg-line-gold-soft">Parler de mon projet</button>
					</form>
				</div>
			</section>
		</main>

		<footer class="site-shell py-8 text-sm text-ink-soft">
			<div class="flex flex-col justify-between gap-3 border-t border-line-blue/15 pt-6 md:flex-row">
				<p>Lignes et courbes - Architecture d'intérieur</p>
				<p>Sèvres - Boulogne - Meudon - Paris 16</p>
			</div>
		</footer>

	</body>
</html>
