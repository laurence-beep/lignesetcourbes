---
import "../styles/global.css";

const navItems = [
	"Accueil",
	"Particuliers",
	"Professionnels",
	"Projets",
	"Accompagnement",
	"Contact",
];

const projects = [
	{
		number: "01",
		slug: "meudon",
		name: "Meudon",
		meta: "Appartement · 90 m²",
		title: "Réinventer les espaces, révéler les personnalités",
		description: "Une redistribution des volumes, une cuisine ouverte et des agencements sur mesure transforment un appartement cloisonné en lieu de vie lumineux, convivial et profondément personnel.",
		details: "Conception globale · Agencements sur mesure · Suivi jusqu’à la réception",
		image: "/images/projects/meudon/meudon-cover.jpg",
		alt: "Cuisine ouverte sur le séjour avec îlot en noyer et quartzite dans un appartement rénové à Meudon",
		credit: "Photographies © Bastien Corre",
	},
	{
		number: "02",
		slug: "viroflay",
		name: "Viroflay",
		meta: "Maison des années 30 · env. 145 m²",
		title: "Faire évoluer une maison sans effacer son histoire",
		description: "Une cuisine ouverte, une verrière et des aménagements sur mesure redonnent lumière, fluidité et convivialité à une maison familiale, tout en préservant son caractère.",
		details: "Rénovation complète · Restructuration · Mobilier sur mesure",
		image: "/images/projects/viroflay/viroflay-cover-v2.webp",
		alt: "Cuisine ouverte avec banquette et verrière en bois dans une maison rénovée à Viroflay",
		credit: "Photographies © Laurence Gaillard / lignes et courbes",
	},
	{
		number: "03",
		slug: "boulogne",
		name: "Boulogne-Billancourt",
		meta: "Appartement neuf · env. 45 m²",
		title: "Donner une âme à un appartement neuf",
		description: "Une cuisine avec îlot convivial, des rangements sur mesure et un intérieur inspiré par le design transforment un appartement neuf en lieu de vie singulier et fonctionnel.",
		details: "Conception intérieure · Cuisine · Rangements et mobilier sur mesure",
		image: "/images/projects/boulogne/gallery/boulogne-03-salon-terrasse.webp",
		alt: "Salon lumineux avec meuble vert sur mesure et terrasse dans un appartement à Boulogne-Billancourt",
		credit: "Photographies © Laurence Gaillard / lignes et courbes",
	},
];

const googleReviews = [
	{
		name: "Alexis B.",
		context: "Rénovation complète d’un appartement",
		quote: "Son exigence dans la préparation, la qualité des choix et la rigueur dans le pilotage du chantier nous ont permis de vivre les travaux sereinement.",
	},
	{
		name: "Catherine",
		context: "Transformation d’une maison",
		quote: "Aujourd’hui, notre maison est à la fois plus agréable, plus fonctionnelle et plus accueillante, tout en restant fidèle à son esprit d’origine.",
	},
	{
		name: "Virginie",
		context: "Rénovation d’un appartement",
		quote: "Une prestation clé en main. Le temps gagné a été précieux. Les échanges sont fluides.",
	},
];

const googleReviewsUrl = "https://www.google.com/maps?cid=15104223004502740442";

const accompanimentSteps = [
	["01", "Étudier et décider", "Analyser le lieu, préciser les besoins, explorer les scénarios et établir un premier ordre de grandeur pour orienter le projet."],
	["02", "Concevoir au juste niveau", "Définir les matériaux, les couleurs, les équipements et la décoration, ou développer une transformation complète avec plans, agencements et mobilier sur mesure."],
	["03", "Préparer et suivre les travaux", "Définir les lots, consulter les entreprises, analyser les offres, aider au choix et assurer le suivi prévu jusqu’à la réception."],
];

---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="lignes et courbes conçoit et accompagne des rénovations globales d'appartements et de maisons dans l'Ouest parisien et en Île-de-France."
		/>
		<title>Architecte d'intérieur à Sèvres | Rénovation globale | lignes et courbes</title>
	</head>
	<body class="bg-paper text-ink">
		<header class="sticky top-0 z-50 border-b border-line-gold/35 bg-paper/98 backdrop-blur-xl">
			<div class="site-shell flex min-h-20 items-center justify-between gap-4">
				<a href="/" aria-label="Lignes et courbes" class="flex items-center gap-3">
					<img src="/brand/lignes-et-courbes-logo.svg" alt="Lignes et courbes" class="h-14 w-auto sm:h-16" />
				</a>
				<nav class="hidden items-center gap-5 text-sm font-medium text-ink-soft lg:flex" aria-label="Navigation principale">
					{navItems.map((item) => <a href={`#${item.toLowerCase().replaceAll(" ", "-").replace("à", "a").replace("é", "e")}`} class="hover:text-line-teal-ink">{item}</a>)}
				</nav>
				<a href="#contact" class="btn btn-primary hidden xl:inline-flex">Parler de mon projet</a>
				<details class="relative lg:hidden">
					<summary class="btn btn-secondary cursor-pointer list-none">Menu</summary>
					<nav class="surface absolute right-0 top-[calc(100%+0.75rem)] grid min-w-60 gap-1 p-2 shadow-soft" aria-label="Navigation mobile">
						{navItems.map((item) => <a href={`#${item.toLowerCase().replaceAll(" ", "-").replace("à", "a").replace("é", "e")}`} class="rounded-site px-4 py-3 text-sm font-medium text-ink-soft hover:bg-line-blue-pale hover:text-line-teal-ink">{item}</a>)}
						<a href="#contact" class="btn btn-primary mt-1">Parler de mon projet</a>
					</nav>
				</details>
			</div>
		</header>

		<main>
			<section id="accueil">
				<section class="border-b border-line-blue/10 bg-paper-warm">
					<div class="site-shell grid gap-8 py-12 md:py-16 lg:min-h-[calc(100svh-80px)] lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-0 lg:py-20">
						<figure class="hero-image-frame order-1 lg:pr-0">
							<img src="/images/boulogne-hero-retouche-v2.jpg" alt="Cuisine ouverte blanche avec îlot central et suspension graphique dans un appartement à Boulogne-Billancourt" class="aspect-[4/3] w-full rounded-site object-cover shadow-soft lg:aspect-[5/4]" />
						</figure>
						<div class="surface relative z-10 order-2 bg-paper p-7 shadow-soft md:p-10 lg:-ml-12 lg:p-12">
          <p class="eyebrow">Architecte d'intérieur à Sèvres · Paris et Ouest parisien</p>
							<h1 class="display-serif mt-5 text-4xl text-line-blue md:text-[2.625rem]">Rénovation globale d'appartements et de maisons</h1>
							<p class="mt-6 text-lg leading-8 text-ink-soft">Du studio à la maison familiale, lignes et courbes conçoit la transformation du lieu, prépare les travaux et en assure le suivi en Île-de-France.</p>
							<p class="mt-4 text-sm font-semibold leading-6 text-line-blue">Conception partout en France · Partir des usages. Transformer les lieux.</p>
							<div class="mt-8 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
								<a href="#projets" class="btn btn-primary">Découvrir les réalisations</a>
								<a href="#contact" class="btn btn-secondary">Parler de mon projet</a>
							</div>
						</div>
					</div>
				</section>

				<section id="projets" class="border-b border-line-blue/10 bg-paper-warm py-16 lg:py-20">
					<div class="site-shell">
						<div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
							<div>
								<p class="eyebrow">Rénovations résidentielles</p>
								<h2 class="display-serif mt-3 max-w-3xl text-3xl text-line-blue md:text-4xl">Trois lieux, trois époques, une même exigence de transformation sur mesure</h2>
							</div>
							<p class="text-ink-soft">Appartement des années 2000, maison des années 30 ou logement neuf : chaque projet part des usages pour composer un lieu singulier, jusque dans les agencements et les détails.</p>
						</div>
						<article class="surface mt-10 grid overflow-hidden bg-paper shadow-soft lg:grid-cols-[1.25fr_0.75fr]">
							<img src={projects[0].image} alt={projects[0].alt} class="aspect-[4/3] h-full min-h-80 w-full object-cover lg:aspect-auto" loading="eager" />
							<div class="flex flex-col justify-center p-7 md:p-10">
								<p class="eyebrow">{projects[0].number} · {projects[0].name}</p>
								<p class="mt-4 text-sm font-semibold text-ink-soft">{projects[0].meta}</p>
								<h3 class="display-serif mt-3 text-2xl text-line-blue">{projects[0].title}</h3>
								<p class="mt-4 text-sm leading-6 text-ink-soft">{projects[0].description}</p>
								<p class="mt-5 text-sm font-semibold leading-6 text-line-blue">{projects[0].details}</p>
								<a href={`/projets/${projects[0].slug}/`} class="mt-6 inline-flex text-sm font-bold text-line-blue underline decoration-line-gold underline-offset-4">Découvrir le projet</a>
								<p class="mt-6 text-xs text-ink-soft">{projects[0].credit}</p>
							</div>
						</article>

						<div class="mt-6 grid gap-6 md:grid-cols-2">
							{projects.slice(1).map((project) => (
								<article class="surface overflow-hidden bg-paper shadow-soft">
									<img src={project.image} alt={project.alt} class="aspect-[3/2] w-full object-cover" loading="lazy" />
									<div class="p-6">
										<p class="eyebrow">{project.number} · {project.name}</p>
										<p class="mt-3 text-sm font-semibold text-ink-soft">{project.meta}</p>
										<h3 class="display-serif mt-3 text-2xl text-line-blue">{project.title}</h3>
										<p class="mt-3 text-sm leading-6 text-ink-soft">{project.description}</p>
										<p class="mt-4 text-sm font-semibold leading-6 text-line-blue">{project.details}</p>
										<a href={`/projets/${project.slug}/`} class="mt-5 inline-flex text-sm font-bold text-line-blue underline decoration-line-gold underline-offset-4">Découvrir le projet</a>
										{project.credit && <p class="mt-5 text-xs text-ink-soft">{project.credit}</p>}
									</div>
								</article>
							))}
						</div>

						<div class="mt-8 flex flex-col items-start justify-between gap-5 border-t border-line-blue/15 pt-7 md:flex-row md:items-center">
							<p class="max-w-2xl text-ink-soft">Vous avez un appartement ou une maison à transformer ? Échangeons sur vos usages, votre calendrier et le potentiel du lieu.</p>
							<a href="#contact" class="btn btn-primary shrink-0">Parler de mon projet</a>
						</div>
					</div>
				</section>

				<section id="avis" class="border-b border-line-blue/10 bg-paper py-14 lg:py-16">
					<div class="site-shell">
						<div class="flex flex-col gap-5 border-b border-line-blue/15 pb-7 md:flex-row md:items-end md:justify-between">
							<div>
								<p class="eyebrow">Avis clients</p>
								<h2 class="display-serif mt-3 max-w-2xl text-3xl text-line-blue md:text-4xl">Des lieux transformés, des travaux vécus sereinement</h2>
							</div>
							<div class="shrink-0 md:text-right">
								<p class="text-lg font-bold tracking-[0.12em] text-line-gold-ink" aria-label="5 étoiles sur 5">★★★★★</p>
								<p class="mt-1 text-sm font-semibold text-line-blue">5,0 sur 5 · 8 avis Google</p>
								<a href={googleReviewsUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm font-bold text-line-blue underline decoration-line-gold underline-offset-4">Lire les avis sur Google</a>
							</div>
						</div>

						<div class="grid md:grid-cols-3">
							{googleReviews.map((review, index) => (
								<blockquote class:list={["py-7 md:px-7 md:py-8", index > 0 && "border-t border-line-blue/15 md:border-l md:border-t-0", index === 0 && "md:pl-0", index === googleReviews.length - 1 && "md:pr-0"]}>
									<p class="display-serif text-lg leading-relaxed text-line-blue md:text-xl">« {review.quote} »</p>
									<p class="mt-4 text-sm font-bold tracking-[0.1em] text-line-gold-ink" aria-label="5 étoiles sur 5">★★★★★</p>
									<footer class="mt-2 text-sm">
										<cite class="not-italic font-bold text-ink">{review.name}</cite>
										<p class="mt-1 leading-5 text-ink-soft">{review.context}</p>
									</footer>
								</blockquote>
							))}
						</div>
					</div>
				</section>

				<section class="border-b border-line-blue/10 bg-paper">
					<div class="site-shell grid gap-10 py-16 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16 lg:py-20">
						<div>
							<p class="eyebrow">Particuliers et professionnels</p>
							<h3 class="display-serif mt-3 text-3xl text-line-blue md:text-4xl">Révéler le potentiel des lieux pour transformer la manière d’y vivre et d’y travailler</h3>
							<p class="mt-5 text-sm leading-6 text-ink-soft">Chaque projet part des usages, des aspirations et du potentiel du bâti pour faire émerger une transformation juste et réalisable.</p>
						</div>
						<div class="grid border-y border-line-blue/15 md:grid-cols-[1.08fr_0.92fr]">
							<article id="particuliers" class="py-7 pr-0 md:pr-8">
								<p class="text-sm font-bold text-line-gold-ink">Pour les particuliers</p>
								<h4 class="mt-4 text-lg font-medium leading-7 text-line-blue">Repenser votre appartement ou votre maison autour de votre façon de vivre</h4>
								<p class="mt-4 text-sm leading-6 text-ink-soft">Une transformation globale qui articule espaces, lumière, matériaux, agencements sur mesure et accompagnement des travaux.</p>
							</article>
							<article id="professionnels" class="border-t border-line-blue/15 py-7 md:border-l md:border-t-0 md:pl-8">
								<p class="text-sm font-bold text-line-gold-ink">Pour les professionnels</p>
								<h4 class="mt-4 text-lg font-medium leading-7 text-line-blue">Transformer les espaces de travail avec celles et ceux qui les vivent</h4>
								<p class="mt-4 text-sm leading-6 text-ink-soft">Une démarche de co-conception pour faire émerger les usages, projeter les évolutions et créer un lieu cohérent avec l’identité et les ambitions de l’organisation.</p>
							</article>
						</div>
					</div>
				</section>

				<section id="accompagnement" class="border-b border-line-blue/10 bg-line-blue-pale/45">
					<div class="site-shell py-16 lg:py-20">
						<div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-end lg:gap-16">
							<div>
								<p class="eyebrow">Votre accompagnement</p>
								<h3 class="display-serif mt-3 text-3xl text-line-blue md:text-4xl">De la première décision au suivi des travaux</h3>
							</div>
							<p class="text-ink-soft">Étude d’orientation, conception ou préparation des travaux : la mission s’ajuste aux étapes dont vous avez réellement besoin.</p>
						</div>
						<div class="mt-10 grid border-y border-line-blue/20 md:grid-cols-3">
							{accompanimentSteps.map(([number, title, text], index) => (
								<article class:list={["py-7 md:px-7", index > 0 && "border-t border-line-blue/20 md:border-l md:border-t-0", index === 0 && "md:pl-0", index === accompanimentSteps.length - 1 && "md:pr-0"]}>
									<p class="inline-flex size-10 items-center justify-center rounded-full border border-line-gold/80 text-xs font-medium tracking-[0.08em] text-line-gold-ink">{number}</p>
									<h4 class="mt-4 text-lg font-medium leading-7 text-line-teal-ink">{title}</h4>
									<p class="mt-3 text-sm leading-6 text-ink-soft">{text}</p>
								</article>
							))}
						</div>
						<p class="mt-6 max-w-4xl text-sm leading-6 text-ink-soft">Ces missions peuvent être confiées ensemble ou séparément. Les entreprises réalisent, facturent et assurent directement les travaux.</p>
					</div>
				</section>
			</section>

			<section id="contact" class="bg-line-blue py-16 text-white lg:py-20">
				<div class="site-shell">
					<div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
						<div>
						<p class="eyebrow text-line-gold-soft">Contact</p>
						<h2 class="display-serif mt-3 text-3xl md:text-4xl">Parlons du lieu que vous voulez transformer</h2>
						<p class="mt-5 max-w-xl font-medium text-white/90">
							Quelques informations suffisent pour comprendre votre projet et préparer un premier échange utile.
						</p>
						</div>
						<div class="mt-8 text-sm font-medium leading-7 text-white/90">
							<p>19, rue des Verrières - 92310 Sèvres</p>
							<p>contact@lignesetcourbes.com</p>
							<p>+33 6 50 14 39 52</p>
						</div>
					</div>
					<form class="surface mt-10 grid gap-6 bg-paper p-5 text-ink shadow-soft md:p-7 lg:grid-cols-[1.25fr_0.75fr]">
						<fieldset class="grid gap-4">
							<legend class="display-serif mb-4 text-2xl text-line-blue">Votre projet</legend>
							<div class="grid gap-4 md:grid-cols-2">
								<label class="grid gap-2 text-sm font-medium">Vous êtes<select name="profil" class="rounded-site border border-line-blue/20 bg-white px-3 py-3 text-ink"><option>Particulier</option><option>Professionnel</option></select></label>
								<label class="grid gap-2 text-sm font-medium">Type de lieu<select name="lieu" class="rounded-site border border-line-blue/20 bg-white px-3 py-3 text-ink"><option value="">À préciser</option><option>Appartement</option><option>Maison</option><option>Bureaux ou lieu professionnel</option><option>Autre</option></select></label>
								<label class="grid gap-2 text-sm font-medium">Localisation<input name="localisation" class="rounded-site border border-line-blue/20 bg-white px-3 py-3 text-ink" placeholder="Ville ou secteur" /></label>
							</div>
						</fieldset>

						<fieldset class="grid gap-4 border-t border-line-blue/15 pt-6 lg:border-l lg:border-t-0 lg:pl-7 lg:pt-0">
							<legend class="display-serif mb-4 text-2xl text-line-blue">Vos coordonnées</legend>
							<div class="grid gap-4 md:grid-cols-2">
								<label class="grid gap-2 text-sm font-medium">Nom<input name="nom" required autocomplete="name" class="rounded-site border border-line-blue/20 bg-white px-3 py-3 text-ink" /></label>
								<label class="grid gap-2 text-sm font-medium">E-mail<input name="email" type="email" required autocomplete="email" class="rounded-site border border-line-blue/20 bg-white px-3 py-3 text-ink" /></label>
							</div>
							<label class="grid gap-2 text-sm font-medium">Téléphone <span class="font-normal text-ink-soft">(facultatif)</span><input name="telephone" type="tel" autocomplete="tel" class="rounded-site border border-line-blue/20 bg-white px-3 py-3 text-ink" /></label>
							<label class="grid gap-2 text-sm font-medium">Votre message<textarea name="message" class="min-h-28 rounded-site border border-line-blue/20 bg-white px-3 py-3 text-ink" placeholder="Quelques mots sur le lieu, vos besoins et vos contraintes"></textarea></label>
						</fieldset>

						<button type="button" class="btn btn-primary lg:col-span-2 lg:min-w-64 lg:justify-self-end">Échanger sur mon projet</button>
					</form>
				</div>
			</section>
		</main>

		<footer class="site-shell py-8 text-sm text-ink-soft">
			<div class="flex flex-col gap-5 border-t border-line-blue/15 pt-6 md:flex-row md:items-center md:justify-between">
				<a href="/" aria-label="Retour à l’accueil">
					<img src="/brand/lignes-et-courbes-logo-carre.svg" alt="Symbole lignes et courbes" class="h-40 w-auto" />
				</a>
				<div class="space-y-1 md:text-right">
					<p>Lignes et courbes - Architecture d'intérieur</p>
					<p>Sèvres - Boulogne - Meudon - Paris 16</p>
				</div>
			</div>
		</footer>

	</body>
</html>
