---
import "../styles/global.css";

const navItems = [
	"Particuliers",
	"Professionnels",
	"Projets",
	"Méthode",
	"Contact",
];

const projects = [
	{ name: "Boulogne", type: "Appartement rénové" },
	{ name: "Viroflay", type: "Lieu de vie optimisé" },
	{ name: "Treeefle", type: "Espace collaboratif" },
	{ name: "AXA Lab", type: "Environnement professionnel" },
];

const methodSteps = [
	["01", "Clarifier", "Objectifs, contraintes, budget et potentiel du lieu."],
	["02", "Concevoir", "Plans, scénarios d'usage, matières, couleurs et mobilier."],
	["03", "Préparer", "Dossier de consultation, devis, arbitrages et planning."],
	["04", "Réaliser", "Coordination, suivi, ajustements et livraison sereine."],
];

---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="lignes et courbes conçoit et accompagne des rénovations globales d'appartements et de maisons dans l'Ouest parisien et en Île-de-France."
		/>
		<title>Architecte d'intérieur à Sèvres | Rénovation globale | lignes et courbes</title>
	</head>
	<body class="bg-paper text-ink">
		<header class="sticky top-0 z-50 border-b border-line-blue/10 bg-paper/94 backdrop-blur-xl">
			<div class="site-shell flex min-h-20 items-center justify-between gap-4">
				<a href="/" aria-label="Lignes et courbes" class="flex items-center gap-3">
					<img src="/brand/lignes-et-courbes-logo.svg" alt="Lignes et courbes" class="h-12 w-auto sm:h-14" />
				</a>
				<nav class="hidden items-center gap-5 text-sm font-semibold text-ink-soft lg:flex" aria-label="Navigation principale">
					{navItems.map((item) => <a href={`#${item.toLowerCase().replaceAll(" ", "-").replace("à", "a").replace("é", "e")}`} class="hover:text-line-blue">{item}</a>)}
				</nav>
				<a href="#contact" class="btn btn-primary hidden xl:inline-flex">Parler de mon projet</a>
				<details class="relative lg:hidden">
					<summary class="btn btn-secondary cursor-pointer list-none">Menu</summary>
					<nav class="surface absolute right-0 top-[calc(100%+0.75rem)] grid min-w-60 gap-1 p-2 shadow-soft" aria-label="Navigation mobile">
						{navItems.map((item) => <a href={`#${item.toLowerCase().replaceAll(" ", "-").replace("à", "a").replace("é", "e")}`} class="rounded-site px-4 py-3 text-sm font-semibold text-ink-soft hover:bg-line-blue-pale hover:text-line-blue">{item}</a>)}
						<a href="#contact" class="btn btn-primary mt-1">Parler de mon projet</a>
					</nav>
				</details>
			</div>
		</header>

		<main>
			<section id="accueil">
				<section class="border-b border-line-blue/10 bg-paper-warm">
					<div class="site-shell grid gap-8 py-12 md:py-16 lg:min-h-[calc(100svh-80px)] lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-0 lg:py-20">
						<figure class="hero-image-frame order-2 lg:order-1 lg:pr-0">
							<img src="/images/loft-colombes-hero.jpeg" alt="Cuisine lumineuse repensée par Lignes et courbes" class="aspect-[4/3] w-full rounded-site object-cover shadow-soft lg:aspect-[5/4]" />
						</figure>
						<div class="surface relative z-10 order-1 bg-paper p-7 shadow-soft md:p-10 lg:order-2 lg:-ml-12 lg:p-12">
          <p class="eyebrow">Architecte d'intérieur à Sèvres · Paris et Ouest parisien</p>
							<h1 class="display-serif mt-5 text-4xl text-line-blue md:text-5xl">Rénovation globale d'appartements et de maisons</h1>
							<p class="mt-6 text-lg leading-8 text-ink-soft">Du studio à la maison familiale, lignes et courbes conçoit la transformation du lieu, prépare les travaux et en assure le suivi en Île-de-France.</p>
							<p class="mt-4 text-sm font-semibold leading-6 text-line-blue">Conception partout en France · Partir des usages. Transformer les lieux.</p>
							<div class="mt-8 flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
								<a href="#projets" class="btn btn-primary">Découvrir les réalisations</a>
								<a href="#contact" class="btn btn-secondary">Parler de mon projet</a>
							</div>
						</div>
					</div>
				</section>

				<section class="border-b border-line-blue/10 bg-paper">
					<div class="site-shell grid gap-10 py-20 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16 lg:py-24">
						<div>
							<p class="eyebrow">Une écoute, deux horizons</p>
							<h3 class="display-serif mt-3 text-4xl text-line-blue">Un cadre clair pour décider sereinement</h3>
							<p class="mt-5 text-ink-soft">Chaque projet commence par une compréhension fine du lieu, de vos usages et des décisions qui comptent vraiment.</p>
						</div>
						<div class="grid border-y border-line-blue/15 md:grid-cols-2">
							<article id="particuliers" class="py-7 pr-0 md:pr-7">
								<p class="text-sm font-bold text-line-gold-ink">Pour les particuliers</p>
								<h4 class="mt-4 text-2xl font-bold text-line-blue">Rendre un lieu évident à vivre</h4>
								<p class="mt-4 text-ink-soft">Clarifier les priorités, révéler le potentiel et préparer les arbitrages avant les travaux.</p>
							</article>
							<article id="professionnels" class="border-t border-line-blue/15 py-7 md:border-l md:border-t-0 md:pl-7">
								<p class="text-sm font-bold text-line-gold-ink">Pour les professionnels</p>
								<h4 class="mt-4 text-2xl font-bold text-line-blue">Créer un espace aligné et accueillant</h4>
								<p class="mt-4 text-ink-soft">Faire parler la marque, les usages et les modes de collaboration sans surcharger l'espace.</p>
							</article>
						</div>
						</div>
				</section>

				<section id="projets" class="border-b border-line-blue/10 bg-paper-warm py-20 lg:py-24">
					<div class="site-shell">
						<div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
							<div>
								<p class="eyebrow">Projets phares</p>
								<h3 class="display-serif mt-3 max-w-3xl text-4xl text-line-blue">Des espaces transformés avec précision et sensibilité</h3>
							</div>
							<p class="text-ink-soft">Maisons, appartements et lieux de travail : chaque réponse naît du contexte, des usages et de la personnalité de ses occupants.</p>
						</div>
						<div class="mt-12 grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:gap-14">
							<article>
								<img src="/images/loft-colombes-hero.jpeg" alt="Meudon" class="aspect-[16/10] w-full rounded-site object-cover shadow-soft" />
								<div class="mt-6 border-l-2 border-line-gold pl-5">
									<p class="eyebrow">Projet repère</p>
									<h4 class="display-serif mt-2 text-3xl text-line-blue">Meudon</h4>
									<p class="mt-2 text-ink-soft">Un lieu de vie transformé par les volumes, la lumière et les circulations.</p>
								</div>
							</article>
							<div class="grid content-start border-b border-line-blue/15">
								{projects.map((project, index) => (
									<article class="grid grid-cols-[3rem_1fr] items-center gap-4 border-t border-line-blue/15 py-6">
										<span class="text-sm font-bold text-line-gold-ink">0{index + 2}</span>
										<span>
											<span class="block text-lg font-bold text-line-blue">{project.name}</span>
											<span class="mt-1 block text-sm text-ink-soft">{project.type}</span>
										</span>
									</article>
								))}
							</div>
						</div>
					</div>
				</section>

				<section id="methode" class="border-b border-line-blue/10 bg-line-blue-pale/45">
					<div class="site-shell grid gap-10 py-20 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16 lg:py-24">
						<div>
							<p class="eyebrow">Méthode</p>
							<h3 class="display-serif mt-3 text-4xl text-line-blue">Avancer avec une vision claire à chaque étape</h3>
							<p class="mt-5 text-ink-soft">Un processus lisible pour préserver l'intention du projet tout en maîtrisant les décisions concrètes.</p>
						</div>
						<div class="grid gap-x-8 md:grid-cols-2">
							{methodSteps.map(([number, title, text]) => (
								<article class="border-t border-line-blue/20 py-6">
									<p class="text-sm font-bold text-line-gold-ink">{number}</p>
									<h4 class="mt-3 text-xl font-bold text-line-blue">{title}</h4>
									<p class="mt-3 text-sm leading-6 text-ink-soft">{text}</p>
								</article>
							))}
						</div>
					</div>
				</section>
			</section>

			<section id="contact" class="bg-line-blue py-20 text-white lg:py-24">
				<div class="site-shell grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
					<div>
						<p class="eyebrow text-line-gold-soft">Contact</p>
						<h2 class="display-serif mt-3 text-4xl md:text-5xl">Parlons du lieu que vous voulez transformer</h2>
						<p class="mt-5 max-w-xl text-white/78">
							Le formulaire prépare le cadrage : type de projet, budget, surface, localisation et délai.
						</p>
						<div class="mt-8 text-sm leading-7 text-white/82">
							<p>19, rue des Verrières - 92310 Sèvres</p>
							<p>contact@lignesetcourbes.com</p>
							<p>+33 6 50 14 39 52</p>
						</div>
					</div>
					<form class="surface grid gap-4 bg-paper p-5 text-ink shadow-soft md:p-7">
						<div class="grid gap-4 md:grid-cols-2">
							<label class="grid gap-2 text-sm font-bold">Type de projet<select class="rounded-site border border-line-blue/20 bg-white px-3 py-3 text-ink"><option>Particulier</option><option>Professionnel</option></select></label>
							<label class="grid gap-2 text-sm font-bold">Budget<input class="rounded-site border border-line-blue/20 bg-white px-3 py-3 text-ink" placeholder="Ex. 80 000 €" /></label>
							<label class="grid gap-2 text-sm font-bold">Surface<input class="rounded-site border border-line-blue/20 bg-white px-3 py-3 text-ink" placeholder="Ex. 90 m2" /></label>
							<label class="grid gap-2 text-sm font-bold">Localisation<input class="rounded-site border border-line-blue/20 bg-white px-3 py-3 text-ink" placeholder="Sèvres, Boulogne, Paris..." /></label>
						</div>
						<label class="grid gap-2 text-sm font-bold">Délai<input class="rounded-site border border-line-blue/20 bg-white px-3 py-3 text-ink" placeholder="Ex. emménagement en septembre" /></label>
						<label class="grid gap-2 text-sm font-bold">Message<textarea class="min-h-32 rounded-site border border-line-blue/20 bg-white px-3 py-3 text-ink" placeholder="Quelques mots sur le lieu, vos envies et vos contraintes"></textarea></label>
						<button type="button" class="btn btn-primary">Parler de mon projet</button>
					</form>
				</div>
			</section>
		</main>

		<footer class="site-shell py-8 text-sm text-ink-soft">
			<div class="flex flex-col justify-between gap-3 border-t border-line-blue/15 pt-6 md:flex-row">
				<p>Lignes et courbes - Architecture d'intérieur</p>
				<p>Sèvres - Boulogne - Meudon - Paris 16</p>
			</div>
		</footer>

	</body>
</html>
