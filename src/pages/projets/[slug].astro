---
import "../../styles/global.css";

const projects = {
  meudon: {
    title: "Meudon | Réinventer un appartement autour de ses habitants",
    metaTitle: "Rénovation d’un appartement de 90 m² à Meudon | lignes et courbes",
    description: "À Meudon, lignes et courbes a transformé un appartement de 90 m² : cuisine ouverte, verrière acier, agencements sur mesure et chantier en 3,5 mois.",
    eyebrow: "Meudon · Appartement 90 m² · 2024–2025",
    intro: "Un appartement traversant recomposé autour de la lumière, de la convivialité et de la personnalité de ses habitants.",
    cover: "/images/projects/meudon/meudon-cover.jpg",
    coverAlt: "Cuisine ouverte sur le séjour avec îlot en noyer et quartzite dans un appartement rénové à Meudon",
    facts: ["Rénovation complète", "Redistribution des volumes", "Agencements sur mesure", "Travaux en 3,5 mois"],
    sections: [
      ["Recomposer les volumes autour de la lumière", "La cuisine prend place dans une ancienne chambre et s’ouvre sur le séjour. La verrière en acier et la circulation traversante relient les espaces et rendent le quotidien plus fluide."],
      ["Un intérieur sur mesure, profondément personnel", "Noyer, quartzite, terracotta, bleu et laiton donnent le ton. Bibliothèques, rangements intégrés et pièces d’eau graphiques transforment chaque usage sans effacer la personnalité des habitants."],
    ],
    gallery: [
      ["/images/projects/meudon/gallery/sejour-agencements-sur-mesure.jpg", "Séjour bleu avec bibliothèque et rangements dessinés sur mesure dans un appartement rénové à Meudon"],
      ["/images/projects/meudon/gallery/cuisine-ilot-noyer.jpg", "Îlot en noyer, quartzite et luminaires en laiton dans la cuisine ouverte à Meudon"],
      ["/images/projects/meudon/gallery/salle-de-bain-sur-mesure.jpg", "Salle de bain graphique avec meuble vasque en bois et faïence colorée à Meudon"],
    ],
    quote: "Son exigence dans la préparation, la qualité des choix et la rigueur dans le pilotage du chantier nous ont permis de vivre les travaux sereinement.",
    quoteBy: "Alexis · Avis Google · 5/5",
    reviewUrl: "https://www.google.com/maps?cid=15104223004502740442",
    cta: "Vous souhaitez repenser les volumes de votre intérieur et créer des solutions sur mesure adaptées à votre quotidien ?",
    credit: "Photographies © Bastien Corre",
  },
  viroflay: {
    title: "Viroflay | Faire évoluer une maison sans effacer son histoire",
    metaTitle: "Rénovation d’une maison à Viroflay (78) | lignes et courbes",
    description: "À Viroflay, lignes et courbes a repensé une maison des années 30 de 145 m² : cuisine ouverte, verrière bois, agencements sur mesure et lumière retrouvée.",
    eyebrow: "Viroflay · Maison des années 30 · Environ 145 m²",
    intro: "Une maison familiale rendue plus lumineuse, plus fluide et plus accueillante, tout en restant fidèle à son histoire.",
    cover: "/images/projects/viroflay/viroflay-cover-v2.jpg",
    coverAlt: "Cuisine ouverte avec banquette et verrière en bois dans une maison rénovée à Viroflay",
    facts: ["Rénovation complète", "Maison des années 30", "Verrière et mobilier sur mesure", "Palette inspirée du jardin"],
    sections: [
      ["Une maison familiale, une nouvelle étape de vie", "Avec le départ progressif des enfants, les propriétaires souhaitaient faire évoluer leurs espaces. Agrandie par une extension, la maison avait besoin de retrouver une continuité entre ses différentes parties et une organisation plus adaptée au quotidien."],
      ["Retrouver la lumière et la convivialité", "La cuisine auparavant fermée est agrandie vers le séjour. Un bar massif laisse place à une banquette sur mesure surmontée d’une verrière en bois. La table de salle à manger est repositionnée et une porte coulissante vitrée laisse pénétrer la lumière du matin."],
      ["Une atmosphère inspirée de la nature", "Des verts doux, des tonalités rosées et des matériaux naturels répondent au jardin. La salle de bain est entièrement repensée et la chambre parentale associe tête de lit, chevets et commode sur mesure dans une palette apaisante."],
      ["Préserver l’esprit de la maison", "Les interventions font dialoguer l’architecture d’origine, l’extension et les nouveaux usages. Le projet modernise la maison sans lui imposer un style uniforme ni effacer son caractère."],
    ],
    gallery: [],
    quote: "Elle a su faire évoluer les espaces en douceur, en apportant plus de lumière, de fluidité et de cohérence, tout en respectant le caractère de la maison.",
    quoteBy: "Catherine · Avis Google · 5/5",
    credit: "Photographies © Laurence Gaillard / lignes et courbes",
  },
  boulogne: {
    title: "Boulogne-Billancourt | Donner une âme à un appartement neuf",
    metaTitle: "Aménagement d’un appartement neuf à Boulogne | lignes et courbes",
    description: "À Boulogne-Billancourt, lignes et courbes a donné une âme à un appartement neuf d’environ 45 m² grâce à une conception intérieure globale et du mobilier sur mesure pensé pour les usages.",
    eyebrow: "Boulogne-Billancourt · Appartement neuf · Environ 45 m²",
    intro: "Un appartement neuf devenu un véritable lieu de vie, pensé pour recevoir, travailler, se ressourcer et se sentir bien chez soi.",
    cover: "/images/boulogne-hero-retouche-v2.jpg",
    coverAlt: "Séjour et cuisine ouverte associant mobilier blanc, bois et pièces de design dans un appartement à Boulogne-Billancourt",
    facts: ["Conception intérieure globale", "Cuisine et îlot sur mesure", "Mobilier conçu pour chaque pièce", "Environ 45 m² et terrasse"],
    sections: [
      ["Un appartement neuf, une identité à révéler", "Dans 45 m² ouverts sur une terrasse, le projet organise les usages et donne au lieu une personnalité qui lui manquait."],
      ["Du sur-mesure pour chaque usage", "Îlot convivial, placard pour la verrerie, tête de lit et espace de travail intégré : chaque élément est dessiné pour optimiser l’espace sans le surcharger."],
    ],
    gallery: [
      ["/images/projects/boulogne/originals/sejour-terrasse-luminaire.jpeg", "Vue large du séjour depuis le canapé, avec le meuble USM, la terrasse et le grand luminaire à Boulogne-Billancourt"],
      ["/images/projects/boulogne/originals/chambre-sur-mesure.jpeg", "Tête de lit, table de nuit et espace de travail conçus sur mesure dans la chambre à Boulogne-Billancourt"],
      ["/images/projects/boulogne/originals/couloir-placard-vert.jpeg", "Perspective du couloir vers le placard vert sur mesure, entre la cuisine et les œuvres encadrées"],
    ],
    quote: null,
    quoteBy: null,
    cta: "Vous souhaitez révéler le potentiel de votre intérieur et concevoir des solutions adaptées à vos usages ?",
    credit: "Photographies © Laurence Gaillard / lignes et courbes",
  },
};

export function getStaticPaths() {
  return ["meudon", "viroflay", "boulogne"].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const project = projects[slug];
const otherProjects = Object.entries(projects).filter(([key]) => key !== slug);
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={project.description} />
    <title>{project.metaTitle}</title>
  </head>
  <body class="bg-paper text-ink">
    <header class="sticky top-0 z-50 border-b border-line-gold/35 bg-paper/98 backdrop-blur-xl">
      <div class="site-shell flex min-h-20 items-center justify-between gap-4">
        <a href="/" aria-label="Retour à l’accueil"><img src="/brand/lignes-et-courbes-logo.svg" alt="Lignes et courbes" class="h-14 w-auto sm:h-16" /></a>
        <nav class="flex items-center gap-4 text-sm font-medium text-ink-soft" aria-label="Navigation du projet">
          <a href="/#projets" class="hover:text-line-teal-ink">Les réalisations</a>
          <a href="/#contact" class="btn btn-primary hidden sm:inline-flex">Parler de mon projet</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="bg-paper-warm py-10 md:py-16">
        <div class="site-shell">
          <a href="/#projets" class="text-sm font-bold text-line-blue underline decoration-line-gold underline-offset-4">← Retour aux réalisations</a>
          <div class="mt-8 grid gap-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-end">
            <div>
              <p class="eyebrow">{project.eyebrow}</p>
              <h1 class="display-serif mt-4 text-4xl text-line-blue md:text-5xl">{project.title}</h1>
              <p class="mt-6 text-lg leading-8 text-ink-soft">{project.intro}</p>
            </div>
            <img src={project.cover} alt={project.coverAlt} class="aspect-[4/3] w-full rounded-site object-cover shadow-soft" loading="eager" />
          </div>
          <div class="mt-8 grid gap-px overflow-hidden rounded-site border border-line-blue/15 bg-line-blue/15 sm:grid-cols-2 lg:grid-cols-4">
            {project.facts.map((fact) => <p class="bg-paper px-5 py-4 text-sm font-medium text-line-blue">{fact}</p>)}
          </div>
        </div>
      </section>

      <section class="py-12 lg:py-14">
        <div class="site-shell grid gap-8 lg:grid-cols-[0.62fr_1.38fr] lg:gap-14">
          <div>
            <p class="eyebrow">Le projet</p>
            <h2 class="display-serif mt-3 text-3xl text-line-blue">Une transformation pensée à partir des usages</h2>
          </div>
          <div class="grid gap-7 md:grid-cols-2">
            {project.sections.map(([title, text]) => (
              <section>
                <h2 class="display-serif text-2xl text-line-blue">{title}</h2>
                <p class="mt-4 leading-7 text-ink-soft">{text}</p>
              </section>
            ))}
          </div>
        </div>
      </section>

      {project.gallery.length > 0 && (
        <section class="border-y border-line-blue/10 bg-paper-warm py-16 lg:py-20">
          <div class="site-shell">
            <p class="eyebrow">Galerie</p>
            <h2 class="display-serif mt-3 text-3xl text-line-blue md:text-4xl">Le projet en images</h2>
            <div class="mt-8 grid gap-5 md:grid-cols-2">
              {project.gallery.map(([src, alt], index) => (
                <img
                  src={src}
                  alt={alt}
                  class:list={[
                    "h-auto w-full rounded-site shadow-soft",
                    index === 0 ? "md:col-span-2" : project.gallery.length === 2 ? "md:col-span-2 md:mx-auto md:max-w-[34rem]" : "",
                    slug === "boulogne" && index === 0 ? "brightness-[.95] saturate-[.82] contrast-[1.03]" : "",
                    slug === "boulogne" && index === 1 ? "brightness-[.98] saturate-[.78] contrast-[1.03]" : "",
                    slug === "boulogne" && index === 2 ? "brightness-[.98] saturate-[.84] contrast-[1.03]" : "",
                  ]}
                  loading="lazy"
                />
              ))}
            </div>
          </div>
        </section>
      )}

      {(project.quote || project.credit) && (
        <section class="py-14 lg:py-16">
          <div class="site-shell grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
            {project.quote ? (
              <blockquote class="max-w-4xl">
                <p class="display-serif text-2xl leading-relaxed text-line-blue md:text-3xl">« {project.quote} »</p>
                <footer class="mt-4 text-sm font-semibold text-ink-soft">{project.quoteBy}</footer>
                {project.reviewUrl && <a href={project.reviewUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm font-bold text-line-blue underline decoration-line-gold underline-offset-4">Lire les avis sur Google</a>}
              </blockquote>
            ) : <div></div>}
            <p class="text-xs text-ink-soft">{project.credit}</p>
          </div>
        </section>
      )}

      <section class="bg-line-blue py-14 text-white lg:py-16">
        <div class="site-shell flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
          <div>
            <p class="eyebrow text-line-gold-soft">Votre projet</p>
            <h2 class="display-serif mt-3 text-3xl md:text-4xl">Et si nous parlions de votre lieu ?</h2>
            {project.cta && <p class="mt-3 max-w-2xl text-white/80">{project.cta}</p>}
          </div>
          <a href="/#contact" class="btn bg-white text-line-blue hover:bg-paper-warm">Parler de mon projet</a>
        </div>
      </section>

      <section class="py-14">
        <div class="site-shell">
          <p class="eyebrow">À découvrir aussi</p>
          <div class="mt-5 flex flex-wrap gap-3">
            {otherProjects.map(([key, item]) => <a href={`/projets/${key}/`} class="btn btn-secondary">{item.eyebrow.split(" · ")[0]}</a>)}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-shell py-8 text-sm text-ink-soft">
      <div class="flex flex-col gap-4 border-t border-line-blue/15 pt-6 md:flex-row md:items-center md:justify-between">
        <a href="/"><img src="/brand/lignes-et-courbes-logo.svg" alt="Lignes et courbes" class="h-12 w-auto" /></a>
        <p>Sèvres · Paris et Ouest parisien</p>
      </div>
    </footer>
  </body>
</html>
